# Your shop's myshopify.com domain.
EXPO_PUBLIC_SHOP_DOMAIN=your-store.myshopify.com

# A Kitenzo headless API key, from Kitenzo > Settings > Headless.
# It is read-only and ships inside your app, which is what it is made for.
EXPO_PUBLIC_KITENZO_API_KEY=kit_live_your_key_here

# The Shopify Markets country to price and sell in (ISO 3166-1 alpha-2).
# Leave empty to sell in the shop's own currency.
EXPO_PUBLIC_COUNTRY_CODE=

# Optional. Bundle ids to feature, in order (comma-separated). Leave empty to
# show every published bundle. The id is in the bundle's URL in Kitenzo.
EXPO_PUBLIC_BUNDLE_IDS=

# Optional. The app uses Shopify's tokenless Storefront API access, which covers
# products and carts. Set a public Storefront API token for higher rate limits.
EXPO_PUBLIC_STOREFRONT_TOKEN=
